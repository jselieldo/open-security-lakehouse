data_dir = "/var/lib/vector"

[api]
enabled = true
address = "0.0.0.0:8686"

[sources.syslog_mtls]
type = "syslog"
address = "0.0.0.0:6514"
mode = "tcp"
max_length = 102400
permit_origin = ["__SYSLOG_ALLOWED_CIDR__"]
tls.enabled = true
tls.ca_file = "/etc/osl/mtls/ca.crt"
tls.crt_file = "/etc/osl/mtls/server.crt"
tls.key_file = "/etc/osl/mtls/server.key"
tls.verify_certificate = true
tls.client_metadata_key = "tls_client"
tls_handshake_timeout_secs = 10

[sources.internal_metrics]
type = "internal_metrics"

[transforms.tag_source]
type = "remap"
inputs = ["syslog_mtls"]
source = '''
if .appname == "osl-smoke" {
  .osl_source = "test-syslog"
} else if .appname == "windows-eventlog" {
  .osl_source = "windows-eventlog"
} else {
  .osl_source = "linux-syslog"
}
'''

[transforms.route_source]
type = "route"
inputs = ["tag_source"]
route.windows = '.osl_source == "windows-eventlog"'
route.test = '.osl_source == "test-syslog"'
route.linux = '.osl_source == "linux-syslog"'

[sinks.osl_api_windows]
type = "http"
inputs = ["route_source.windows"]
uri = "http://api:8000/api/v1/ingestion/vector"
method = "post"
compression = "none"
healthcheck.enabled = false
acknowledgements.enabled = true

[sinks.osl_api_windows.auth]
strategy = "bearer"
token = "__COLLECTOR_API_TOKEN__"

[sinks.osl_api_windows.encoding]
codec = "json"

[sinks.osl_api_windows.framing]
method = "newline_delimited"

[sinks.osl_api_windows.batch]
max_events = 100
timeout_secs = 2

[sinks.osl_api_windows.buffer]
type = "disk"
max_size = 268435488
when_full = "block"

[sinks.osl_api_linux]
type = "http"
inputs = ["route_source.linux"]
uri = "http://api:8000/api/v1/ingestion/vector"
method = "post"
compression = "none"
healthcheck.enabled = false
acknowledgements.enabled = true

[sinks.osl_api_linux.auth]
strategy = "bearer"
token = "__COLLECTOR_API_TOKEN__"

[sinks.osl_api_linux.encoding]
codec = "json"

[sinks.osl_api_linux.framing]
method = "newline_delimited"

[sinks.osl_api_linux.batch]
max_events = 100
timeout_secs = 2

[sinks.osl_api_linux.buffer]
type = "disk"
max_size = 268435488
when_full = "block"

[sinks.osl_api_test]
type = "http"
inputs = ["route_source.test"]
uri = "http://api:8000/api/v1/ingestion/vector"
method = "post"
compression = "none"
healthcheck.enabled = false
acknowledgements.enabled = true

[sinks.osl_api_test.auth]
strategy = "bearer"
token = "__COLLECTOR_API_TOKEN__"

[sinks.osl_api_test.encoding]
codec = "json"

[sinks.osl_api_test.framing]
method = "newline_delimited"

[sinks.osl_api_test.batch]
max_events = 100
timeout_secs = 2

[sinks.osl_api_test.buffer]
type = "disk"
max_size = 268435488
when_full = "block"

[sinks.prometheus_exporter]
type = "prometheus_exporter"
inputs = ["internal_metrics"]
address = "0.0.0.0:9598"
