[Unit]
Description=Open Security Lakehouse Docker application log collector
Documentation=https://github.com/jselieldo/open-security-lakehouse
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=__OSL_USER__
Group=__OSL_GROUP__
SupplementaryGroups=docker
WorkingDirectory=__OSL_REPOSITORY__
EnvironmentFile=/etc/osl/docker-collector.env
Environment=OSL_DOCKER_LOG_CHECKPOINT=/var/lib/osl-docker-log-collector/checkpoint
ExecStart=/usr/bin/python3 __OSL_REPOSITORY__/scripts/collect-docker-logs.py
Restart=on-failure
RestartSec=5s
StateDirectory=osl-docker-log-collector
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
