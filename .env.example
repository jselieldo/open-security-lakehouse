# Copy to .env and replace every value marked CHANGE_ME before starting.
POSTGRES_DB=osl
POSTGRES_USER=osl
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_database_password

# Initial API bearer token. Generate with: openssl rand -hex 32
OSL_API_TOKEN=CHANGE_ME_generate_with_openssl_rand_hex_32

# Dedicated machine credential for Vector. It grants ingestion only.
COLLECTOR_API_TOKEN=CHANGE_ME_generate_with_openssl_rand_hex_32

# S3 credentials used only inside the private Compose network.
# Use only letters, digits, underscore, and hyphen (hex output is valid).
S3_ACCESS_KEY=CHANGE_ME_generate_a_random_access_key
S3_SECRET_KEY=CHANGE_ME_generate_a_long_random_secret_key
S3_BUCKET=osl-security-data

# Host binding. Keep loopback-only for a single-machine installation.
OSL_BIND_ADDRESS=127.0.0.1
OSL_API_PORT=8000

# Application behavior
LOG_LEVEL=INFO

# TCP syslog listener. Restrict the CIDR to the local network.
SYSLOG_BIND_ADDRESS=0.0.0.0
SYSLOG_PORT=5514
SYSLOG_ALLOWED_CIDR=192.168.0.0/16

# Observability UIs remain loopback-only. Generate the Grafana password.
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# Authentication. Use hybrid only during an upgrade from the legacy bearer token.
AUTH_MODE=oidc
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/osl
OIDC_JWKS_URL=http://keycloak:8080/realms/osl/protocol/openid-connect/certs
OIDC_AUDIENCE=osl-api
OIDC_CLIENT_ID=osl-console

# Keycloak has a dedicated database and bootstrap administrator.
KEYCLOAK_DB_PASSWORD=CHANGE_ME_use_a_long_random_keycloak_database_password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_use_a_long_random_keycloak_admin_password

# Local validation accounts. Replace all values before starting.
OIDC_TEST_USERNAME=osl-analyst
OIDC_TEST_PASSWORD=CHANGE_ME_use_a_long_random_analyst_password
OIDC_ADMIN_USERNAME=osl-admin
OIDC_ADMIN_PASSWORD=CHANGE_ME_use_a_long_random_osl_admin_password

